<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="plugin.video.primeinterface" name="Prime Scene" version="0.2.0" provider-name="AgreeWithScotty">
  <requires>
    <import addon="xbmc.python" version="3.0.1" />
    <import addon="script.module.beautifulsoup4" version="4.6.3+matrix.1" />
    <import addon="script.module.mechanicalsoup" version="0.12.0+matrix.1" />
    <import addon="script.module.pyxbmct" version="1.3.1+matrix.1" />
    <import addon="script.module.inputstreamhelper" version="0.4.4+matrix.1" />
    <import addon="script.module.requests" version="2.22.0+matrix.1" />
    <import addon="script.module.pyautogui" version="0.9.49+matrix.1" />
    <import addon="script.module.amazoncaptcha" version="0.5.11+matrix.1" />
  </requires>
  <extension point="xbmc.python.script" library="default.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.service" library="service.py" />
  <extension point="xbmc.addon.metadata">
    <platform>all</platform>
    <reuselanguageinvoker>false</reuselanguageinvoker>
    <license>GPL-3.0-or-later</license>
    <source>https://github.com/AgreeWithScotty/PrimeScene</source>
    <assets>
      <icon>icon.png</icon>
      <fanart>fanart.jpg</fanart>
    </assets>
    <summary lang="en_GB">Prime Video in the Aurora Cinema interface</summary>
    <description lang="en_GB">Prime Video add-on maintained by AgreeWithScotty. Aurora Cinema is the home, title and player screen. Website sign-in and the storefront reader use your own account. Includes GPL-3.0-or-later backend code derived from Sandmann79/xbmc. See NOTICE.md for upstream credits. Not affiliated with Amazon.</description>
    <disclaimer lang="en_GB">Uses your own Amazon account. Playback uses this add-on's existing player path and Kodi inputstream. Not affiliated with Amazon.</disclaimer>
    <news>0.2.0[CR]- Aurora Cinema home, title page and player overlay.[CR]- Includes the 0.1.28 website session and storefront catalogue.[CR]- Sign-in, search, settings and playback stay in place.</news>
  </extension>
</addon>
<addon id="plugin.video.smoothflix" name="SmoothFlix" version="0.3.0" provider-name="Scott">
  <requires>
    <import addon="xbmc.python" version="3.0.1"/>
    <import addon="inputstream.adaptive" version="21.5.0"/>
    <import addon="script.module.inputstreamhelper" version="0.8.0"/>
    <import addon="script.module.requests" version="2.27.0"/>
    <import addon="script.module.pyaes" version="1.6.1"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="default.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.service" library="service.py"/>
  <extension point="xbmc.addon.metadata">
    <reuselanguageinvoker>true</reuselanguageinvoker>
    <summary lang="en_GB">Netflix catalogue and playback for your own account</summary>
    <description lang="en_GB">SmoothFlix signs in with your Netflix account and plays through inputstream.adaptive and Widevine. Aurora Cinema is the home, title and player screen: near-black, type-led, with artwork loaded by Kodi. A classic directory list is in the settings.</description>
    <disclaimer lang="en_GB">Uses your own Netflix account. Video is played with Kodi inputstream.adaptive and Widevine. No other sources are used.</disclaimer>
    <platform>all</platform>
    <license>GPL-3.0-only</license>
    <source>https://github.com/AgreeWithScotty/SmoothFlix</source>
    <news>v0.3.0 (2026-11-19)[CR]- Aurora Cinema home, title page and player overlay.[CR]- Classic directory list remains available in settings.</news>
    <assets>
      <icon>icon.png</icon>
      <fanart>fanart.jpg</fanart>
    </assets>
  </extension>
</addon>
