<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="plugin.video.primeinterface" name="Smooth Prime" version="0.2.59" provider-name="AgreeWithScotty">
  <requires>
    <import addon="xbmc.python" version="3.0.1" />
    <import addon="script.module.inputstreamhelper" version="0.8.6" />
  </requires>
  <extension point="xbmc.python.pluginsource" library="default.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.service" library="service.py" />
  <extension point="xbmc.addon.metadata">
    <platform>all</platform>
    <reuselanguageinvoker>false</reuselanguageinvoker>
    <license>GPL-3.0-only</license>
    <source>https://github.com/AgreeWithScotty/PrimeScene</source>
    <assets>
      <icon>icon.png</icon>
      <fanart>resources/skins/Default/media/splash.png</fanart>
    </assets>
    <summary lang="en_GB">Smooth Prime: Prime Video in the Aurora Cinema interface</summary>
    <description lang="en_GB">Smooth Prime is maintained by AgreeWithScotty. Catalog, account authentication, HTTPS transport, media resources, Widevine license relay, subtitles and playback lifecycle use independently written implementations. The dedicated Aurora interface is adapted from Scott's SmoothFlix. Not affiliated with Amazon. See NOTICE.md for asset and dependency licenses.</description>
    <disclaimer lang="en_GB">Uses your own Amazon account and Kodi InputStream Adaptive with Widevine. Not affiliated with Amazon.</disclaimer>
    <news>0.2.59[CR]- Keep the launch splash opaque through the handoff to the prepared application window.[CR]- Open Movies after the first four genre backgrounds are ready; continue remaining artwork in the background.[CR]- Replace the Purchases top tab with your Amazon Watchlist, refreshed when opened.[CR]- Move Purchases into the Movies and TV genre rows, filtered to the selected media type.[CR]- Preserve account isolation, pagination, playback return, genre typography and category-specific diagnostics.</news>
  </extension>
</addon>
<addon id="plugin.video.smoothflix" name="SmoothFlix" version="0.3.1" provider-name="Scott">
  <requires>
    <import addon="xbmc.python" version="3.0.1"/>
    <import addon="inputstream.adaptive" version="21.5.0"/>
    <import addon="script.module.inputstreamhelper" version="0.8.0"/>
    <import addon="script.module.requests" version="2.27.0"/>
    <import addon="script.module.pyaes" version="1.6.1"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="default.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.service" library="service.py"/>
  <extension point="xbmc.addon.metadata">
    <reuselanguageinvoker>true</reuselanguageinvoker>
    <summary lang="en_GB">Netflix catalogue and playback for your own account</summary>
    <description lang="en_GB">SmoothFlix signs in with your Netflix account and plays through inputstream.adaptive and Widevine. Aurora Cinema is the home, title and player screen: near-black, type-led, with artwork loaded by Kodi. A classic directory list is in the settings.</description>
    <disclaimer lang="en_GB">Uses your own Netflix account. Video is played with Kodi inputstream.adaptive and Widevine. No other sources are used.</disclaimer>
    <platform>all</platform>
    <license>GPL-3.0-only</license>
    <source>https://github.com/AgreeWithScotty/SmoothFlix</source>
    <news>v0.3.1 (2026-11-20)[CR]- Aurora Cinema windows use SmoothFlixHome.xml, SmoothFlixTitle.xml and SmoothFlixPlayer.xml so Kodi 21 Estuary does not load its own Home.xml.[CR]- A window that fails to open logs the traceback and shows the error.</news>
    <assets>
      <icon>icon.png</icon>
      <fanart>fanart.jpg</fanart>
    </assets>
  </extension>
</addon>
